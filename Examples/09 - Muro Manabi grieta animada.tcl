timeSeries Path 1 -time {0.0 1.0 100.0} -values {0.0 1.0 1.0}
pattern Plain 1 1 { foreach {n fx fy} $Fs { load $n $fx $fy } }
timeSeries Path 2 -time {0.0 1.0 100.0} -values {0.0 0.0 99.0}
pattern Plain 2 2 { foreach {n fx fy} $Fq { load $n $fx $fy } }
system BandGeneral; numberer RCM; constraints Plain; test NormDispIncr 1.0e-6 100 0; algorithm KrylovNewton; analysis Static
# ---- 1) estática: peso propio, relleno y empuje de Coulomb (el sismo todavía en cero) ----
integrator LoadControl 0.2
set ok [analyze 5]
# ---- 2) el sismo sube s = 0 .. 1.4; cada paso imprime un cuadro  HKFRAME s | u | d  (d = daño a tracción de cada elemento) ----
set nsteps 70
set tip 889
set du -0.0001
set smax 1.4
proc cuadro {s} {
    global nxy nel tip
    set u {}
    for {set n 1} {$n <= $nxy} {incr n} { lappend u [format %.4g [nodeDisp $n 1]] [format %.4g [nodeDisp $n 2]] }
    set dm {}
    for {set e 1} {$e <= $nel} {incr e} { lappend dm [format %.3g [lindex [eleResponse $e material 1 damage] 0]] }
    puts "HKFRAME $s [format %.2f [expr {[nodeDisp $tip 1]*1000}]] | $u | $dm"
}
# el sismo se sube por DESPLAZAMIENTO de la coronacion (el ablandamiento deja atras el pico de carga: con control de carga no pasa de ahi)
integrator DisplacementControl $tip 1 $du
cuadro 0.0
set sfinal 0.0
set fallo 0
set k 0
while {$sfinal < $smax && $k < $nsteps && !$fallo} {
    incr k
    set bien 0
    # si el paso no converge (la grieta se localiza) se prueba más fino y luego más grueso: el ablandamiento no es monótono en el paso
    foreach m {1.0 0.05 4.0 10.0 25.0} {
        integrator DisplacementControl $tip 1 [expr {$du*$m}]
        if {[analyze 1] == 0} { set bien 1; break }
    }
    integrator DisplacementControl $tip 1 $du
    if {!$bien} { set fallo 1; break }
    set sfinal [expr {[getTime] - 1.0}]
    cuadro [format %.4f $sfinal]
}
#show
puts "HEKATAN:s_final=$sfinal"
puts "HEKATAN:cuadros=[expr {$fallo ? $k : $nsteps+1}]"
## La grieta, paso a paso
# Dale a **Reproducir** o arrastra el control. El color es el *daño a tracción* d (0 = sano, 1 = abierta): el hormigón sin acero falla por una sola grieta en el pie del fuste.
